# ---------------------------------------------------------------------------
# Single Sign-On (SSO) — OAuth 2.0 / OpenID Connect
#
# Copy to .env and fill in values from your Identity Provider (IdP), e.g.
# Okta, Auth0, Azure AD / Entra ID, Google, Keycloak.
# NEVER commit the real .env — only this example file.
# ---------------------------------------------------------------------------

# Confidential client credentials issued by the IdP
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Must exactly match a redirect URI registered with the IdP
SSO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback

# OIDC issuer — used to validate the `iss` claim in the ID token
SSO_ISSUER=https://your-idp.example.com

# IdP endpoints (from the provider's OIDC discovery document,
# e.g. <issuer>/.well-known/openid-configuration)
SSO_AUTHORIZATION_ENDPOINT=https://your-idp.example.com/oauth2/v1/authorize
SSO_TOKEN_ENDPOINT=https://your-idp.example.com/oauth2/v1/token
SSO_USERINFO_ENDPOINT=https://your-idp.example.com/oauth2/v1/userinfo
SSO_JWKS_URI=https://your-idp.example.com/oauth2/v1/keys

# Requested scopes (must include `openid`)
SSO_SCOPE=openid profile email

# Optional: restrict sign-in to specific email domains (comma-separated).
# Leave empty to allow any authenticated IdP user.
SSO_ALLOWED_DOMAINS=

# Optional: where to send the browser after success/failure. If unset, the
# callback responds with JSON instead of redirecting.
SSO_POST_LOGIN_REDIRECT=
SSO_LOGIN_PAGE_URL=

# Optional: session lifetime in milliseconds (default 3600000 = 1 hour)
SSO_SESSION_TTL_MS=3600000

# Optional: label shown on the login button
SSO_BUTTON_LABEL=Login with SSO

# Set to "production" to mark session cookies as Secure (HTTPS-only)
NODE_ENV=development
